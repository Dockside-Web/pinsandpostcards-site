---
// A map pin: sage, or the brand's terracotta (the one accent). `outline` draws a
// cream edge round it: terracotta never sits straight on sage (the brand sheet).
interface Props {
  color?: "sage" | "terracotta" | "ink";
  // Colour of the hole in the head, to match the background behind it.
  hole?: string;
  outline?: boolean;
  class?: string;
  style?: string;
}
const { color = "sage", hole = "#f4f1ea", outline = false, class: className = "h-11 w-auto", style } = Astro.props;
const fills: Record<string, string> = { sage: "#3f5e57", terracotta: "#c8553d", ink: "#22322e" };
---

<svg class={className} style={style} viewBox="0 0 34 44" aria-hidden="true" overflow="visible">
  <path
    d="M17 1C8.2 1 1 8 1 16.7 1 28.5 17 43 17 43s16-14.5 16-26.3C33 8 25.8 1 17 1z"
    fill={fills[color]}
    stroke={outline ? "#f4f1ea" : undefined}
    stroke-width={outline ? 2.2 : undefined}></path>
  <circle cx="17" cy="16.5" r="5.5" fill={hole}></circle>
</svg>
