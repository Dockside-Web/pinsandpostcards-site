---
// /changelog: what's changed in the app. One Markdown file per version in
// src/content/changelog/ (src/content.config.ts checks its header). The newest
// is shown in full: its date and version (with NEW), its title, a line saying
// what it is, an optional picture and the details (the file's text). Earlier
// ones show the same date line, title and line, folded: "See what changed"
// opens the picture and details. Each has its own address, /changelog#v1-0,
// which opens it.
import { Image } from "astro:assets";
import { render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { formatDate } from "../lib/blog";
import { getReleases, releaseAnchor, type Release } from "../lib/changelog";

const [latest, ...earlier] = await Promise.all((await getReleases()).map(async (r) => ({ ...r, Content: (await render(r)).Content })));

const metaDescription = "Everything that's changed in Travel Map & Journal: new features, improvements and fixes, version by version.";

const isoDay = (d: Date) => d.toISOString().slice(0, 10);
const picture = (data: Release["data"]) =>
  data.image && { src: data.image, alt: data.imageAlt ?? "", widths: [640, 1000, 1400], sizes: "(min-width: 768px) 45rem, 100vw" };
---

<Layout title="Changelog" description={metaDescription} nav="overlay">
  <PageHero title="Changelog" lede="Updates, new features and fixes to the app." slice="62%" seed={41} stamp={["NEWS", "UPDATES"]} />
  <section class="px-4 pt-14 pb-24 sm:px-8 md:pt-20 md:pb-32">
    <div class="mx-auto max-w-[45rem]">
      {
        latest && (
          <article id={releaseAnchor(latest.data.version)} class="scroll-mt-24">
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-ui text-[0.95rem] text-muted">
              <span class="rounded-full bg-app-green px-2.5 py-1 text-[0.72rem] leading-none font-semibold tracking-[0.08em] text-white">NEW</span>
              <time datetime={isoDay(latest.data.date)}>{formatDate(latest.data.date)}</time>
              <span aria-hidden="true">·</span>
              <span>Version {latest.data.version}</span>
            </p>
            <h2 class="mt-3.5 text-[1.9rem] leading-tight font-semibold tracking-tight text-ink md:text-[2.25rem]">{latest.data.title}</h2>
            <p class="mt-3 text-[1.15rem] leading-relaxed text-body">{latest.data.summary}</p>
            {latest.data.image && <Image {...picture(latest.data)!} class="shot mt-7" />}
            <div class="post-body changelog-body mt-7">
              <latest.Content />
            </div>
          </article>
        )
      }
      {
        earlier.length > 0 && (
          <div class="mt-16 md:mt-20">
            <h2 class="mb-1 font-ui text-[0.8rem] font-semibold tracking-[0.12em] text-muted uppercase">Earlier updates</h2>
            {earlier.map(({ data, Content }) => (
              <details id={releaseAnchor(data.version)} class="release scroll-mt-24 border-t border-line last:border-b">
                <summary class="block cursor-pointer py-8">
                  <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-ui text-[0.95rem] text-muted">
                    <time datetime={isoDay(data.date)}>{formatDate(data.date)}</time>
                    <span aria-hidden="true">·</span>
                    <span>Version {data.version}</span>
                  </p>
                  <h3 class="mt-3.5 text-[1.9rem] leading-tight font-semibold tracking-tight text-ink md:text-[2.25rem]">{data.title}</h3>
                  <p class="mt-3 text-[1.15rem] leading-relaxed text-body">{data.summary}</p>
                  <span class="mt-3 inline-flex min-h-11 items-center gap-1.5 font-ui text-[0.95rem] font-semibold text-slate">
                    <span class="more">See what changed</span>
                    <span class="less">Hide</span>
                    <svg class="chev transition-transform" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                  </span>
                </summary>
                <div class="pb-10">
                  {data.image && <Image {...picture(data)!} class="shot" />}
                  <div class:list={["post-body changelog-body", data.image && "mt-7"]}>
                    <Content />
                  </div>
                </div>
              </details>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Layout>

<script>
  // /changelog#v1-0 opens that update when it's folded.
  const open = () => {
    const target = location.hash && document.getElementById(location.hash.slice(1));
    if (target instanceof HTMLDetailsElement) target.open = true;
  };
  open();
  addEventListener("hashchange", open);
</script>

<style>
  .shot {
    display: block;
    width: 100%;
    border-radius: 14px;
    border: 1px solid var(--color-line);
    box-shadow: 0 30px 60px -30px rgba(35, 49, 61, 0.45);
  }
  /* A release's details: the blog's text, a size down, its headings small. */
  .changelog-body {
    font-size: 1.08rem;
    line-height: 1.7;
  }
  .changelog-body :global(h3) {
    margin-top: 1.6em;
    font-size: 1.2rem;
  }
  .release summary::-webkit-details-marker {
    display: none;
  }
  .release[open] .more,
  .release:not([open]) .less {
    display: none;
  }
  .release[open] .chev {
    transform: rotate(180deg);
  }
</style>
